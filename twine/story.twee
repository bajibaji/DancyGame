  "c0213c": {
    "title": "她还没听到死讯",
    "locationId": "hz-hospital",
    "timeOfDay": "夜",
    "options": [
      {
        "key": "A",
        "tendency": "evidence",
        "risk": "low",
        "effects": {
          "clue": 1,
          "world": 1,
          "flags": [
            "HOSPITAL_TRACE_0"
          ]
        },
        "consequence": "录像里，护士服的人进门七分钟，出来的时候手里多了一个托盘。\n\n托盘上盖着布。\n\n「布是什么颜色？」\n\n「白的。」\n\n「有没有字？」\n\n「看不清。」",
        "progress": "穿护士服的人端走了一个托盘。"
      },
      {
        "key": "B",
        "tendency": "evidence",
        "risk": "low",
        "effects": {
          "clue": 1,
          "world": 1,
          "flags": [
            "HOSPITAL_TRACE_1"
          ]
        },
        "consequence": "顾淮先核医护处置与可取样位置，分别记录病房和走廊。你说闻着像林边，却将这句留在观察页；样品成分和死因仍待检验，不以熟悉气味作结论。",
        "progress": "病房留样与气味印象分开。"
      },
      {
        "key": "C",
        "tendency": "empathy",
        "risk": "low",
        "effects": {
          "relation": 1,
          "world": -1,
          "flags": [
            "HOSPITAL_TRACE_2"
          ]
        },
        "consequence": "「我签了我的位置和报警时间。」他说，「签名前我又添了一条：未见来人面部。」\n\n「为什么添这条？」\n\n「因为我没看见。不能让别人替我写。」",
        "progress": "战远只签了自己看见的部分。"
      }
    ]
  },
